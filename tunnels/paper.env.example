# Configuration of tunnels/reproduce_paper.sh: the only place where the server paths are set.
# Copy it to tunnels/paper.env (which is in .gitignore) and fill it in:
#   cp tunnels/paper.env.example tunnels/paper.env
# It is a KEY=value file loaded with `source`; values may use earlier variables.

# Directory of the data on the server. REQUIRED.
DATA_DIR=
# Wikidata graph (the enumerated .dat). Read only: it is linked from OUT_DIR.
WD_DAT=${DATA_DIR}/wikidata-enumerated.dat
# Dictionaries of predicates (.P) and of subjects/objects (.SO) of the graph.
WD_DICT_P=${DATA_DIR}/wikidata-unsorted-enumerated.dat.P
WD_DICT_SO=${DATA_DIR}/wikidata-unsorted-enumerated.dat.SO
# Wikidata RPQ log (paths-final.tsv).
WD_QUERIES=${DATA_DIR}/paths-final.tsv
# Expression shapes of Hammerer & Martens, for the generated queries.
SHAPES_CSV=${DATA_DIR}/WD_organic.csv   # https://zenodo.org/records/15363430

# Output directory. REQUIRED. It cannot be inside the directory of WD_DAT.
OUT_DIR=

# Directory of the binaries. Empty: <repo>/build.
BUILD_DIR=
# Install prefix of the extended SDSL, for the build step. Empty: $HOME.
SDSL_ROOT=
# Source code of navGraph (github.com/j-rparra/navGraph). Empty: Compact (navGraph) is skipped.
NAVGRAPH_DIR=
# Time limit (s) of the Ring-RPQ baselines in ring-tunnels (-DRING_TIMEOUT).
RING_TIMEOUT=60

# Generated queries: number and seed (output in OUT_DIR/gen-<GEN_N>-<GEN_SEED>).
GEN_N=1000
GEN_SEED=1

# Extra options for ring-tunnels, e.g. "--max-queries 50" for a quick test.
EXTRA_OPTS=

# MillenniumDB times for the PathFinder comparison table (pathfinder step), from the MillDB-PathFinder
# repo (see pf/README.md): results.csv from join_pf.py and raw.csv from run_pf.py. Optional, but give
# both or neither; if empty, the t_MDB columns are omitted.
MDB_RESULTS=
MDB_RAW=
